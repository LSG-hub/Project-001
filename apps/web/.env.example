# Copy to .env.local for local development. Never commit real values.

# Admin login. Generate both values with: npm run admin:hash -w @project001/web
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Email to the owner on each new sign-up (any SMTP server; Zoho shown).
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
NOTIFY_FROM=

# Waitlist storage. Unset = local file (.data/waitlist.json); "firestore" = Firestore.
WAITLIST_STORE=

# Address used in sign-up emails (the admin link). Set per environment.
SITE_URL=http://localhost:5301
